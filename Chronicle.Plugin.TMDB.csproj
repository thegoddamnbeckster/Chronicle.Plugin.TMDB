<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Chronicle.Plugin.TMDB</AssemblyName>
    <RootNamespace>Chronicle.Plugin.TMDB</RootNamespace>
    <!-- Plugin DLL must not copy Chronicle.Plugins into its output — it will be
         provided by the host at runtime. Mark the reference as Private=false. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Local path reference during development.
         Replace with NuGet package reference once Chronicle.Plugins is published. -->
    <ProjectReference Include="..\Chronicle\src\Chronicle.Plugins\Chronicle.Plugins.csproj"
                      Private="false"
                      ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <!-- HttpClient factory + polly-friendly extensions -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.3" />
    <!-- JSON (de)serialisation -->
    <PackageReference Include="System.Text.Json" Version="9.0.3" />
    <!--
      Serilog is loaded by the Chronicle host, not bundled here (ExcludeAssets=runtime).
      Pinned to the EXACT version Chronicle.API itself references, matching the convention
      Chronicle.Plugin.Simkl's csproj already documents: a floating range (e.g. "4.*") can
      resolve to a newer patch than what the host has loaded, and a version mismatch throws
      FileNotFoundException at runtime the moment the plugin touches logging. Bump this only
      when Chronicle.API's own Serilog version changes.
    -->
    <PackageReference Include="Serilog" Version="4.3.0" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <PropertyGroup>
    <InternalsVisibleTo>Chronicle.Plugin.TMDB.Tests</InternalsVisibleTo>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests/**" />
  </ItemGroup>

  <!-- Copy manifest.json to output directory so PluginHostService can read it -->
  <ItemGroup>
    <None Include="manifest.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
